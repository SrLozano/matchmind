{
  "name": "matchmind",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "make api-dev",
    "api:test": "make api-test",
    "web:dev": "pnpm --filter @matchmind/web dev",
    "web:build": "pnpm --filter @matchmind/web build",
    "web:start": "pnpm --filter @matchmind/web start",
    "web:lint": "pnpm --filter @matchmind/web lint"
  }
}
